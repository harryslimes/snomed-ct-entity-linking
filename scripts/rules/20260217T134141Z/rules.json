{
  "version": "4.0",
  "mappings": {
    "TB": "tuberculosis",
    "LH": "labile essential hypertension",
    "PFO": "patent foramen ovale",
    "TEE": "transesophageal echocardiography",
    "TIA": "transient ischemic attack",
    "SCM": "sternocleidomastoid muscle",
    "HKS": "heel-to-knee test",
    "FNF": "finger-to-nose test",
    "DTRs": "deep tendon reflexes",
    "CTAB": "clear to auscultation bilaterally",
    "PERRL": "pupils equal round reactive to light",
    "EOMI": "extraocular movements intact",
    "VFF": "visual fields full",
    "IGG": "immunoglobulin G",
    "LDL": "low density lipoprotein cholesterol measurement",
    "CHOL/HD": "cholesterol to HDL ratio measurement",
    "LDLcalc": "calculated low density lipoprotein cholesterol level",
    "eAG": "estimated average glucose"
  },
  "g_rules": [
    {
      "id": "G1",
      "rule": "For body structure spans, prefer the most specific anatomical structure concept that accurately represents the referenced anatomy. When multiple hierarchy types exist, prefer 'body structure' over functional or morphologic classifications.",
      "stages": [
        "stage_3_select"
      ]
    },
    {
      "id": "G2",
      "rule": "For procedure spans, distinguish between the actual procedure being performed versus the measurement/test result. Select procedure concepts for actions/interventions and finding concepts for results/observations.",
      "stages": [
        "stage_2_search",
        "stage_3_select"
      ]
    },
    {
      "id": "G3",
      "rule": "When a span appears in a negated context (preceded by 'no', 'denies', 'without', etc.), search for and select the positive form of the concept, not a 'absence of' variant.",
      "stages": [
        "stage_2_search",
        "stage_3_select"
      ]
    },
    {
      "id": "G4",
      "rule": "For medication-related spans, distinguish between the medication substance, the therapy/administration procedure, and the prescription act based on context.",
      "stages": [
        "stage_3_select"
      ]
    }
  ],
  "structured_rules": [
    {
      "rule_id": "R1",
      "concept_type": "Anatomical_Structure",
      "applies_to": {
        "ancestor_concept_ids": [
          91723000
        ],
        "sections": null,
        "span_pattern": null
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "For anatomical terms, search using the exact anatomical name. For colloquial terms or abbreviations, expand to the full anatomical structure name."
      },
      "stage_3_select": {
        "disambiguation_logic": "Select the most specific anatomical concept that matches the referenced structure. If multiple matches exist at different specificity levels, prefer the more specific concept unless context suggests a broader region.",
        "preferred_hierarchy": "body structure",
        "reject_hierarchies": [
          "morphologic abnormality",
          "finding"
        ]
      }
    },
    {
      "rule_id": "R2",
      "concept_type": "Clinical_Finding",
      "applies_to": {
        "ancestor_concept_ids": [
          404684003
        ],
        "sections": null,
        "span_pattern": null
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "Search for the clinical observation or finding described. For symptom descriptions, use the medical term for the symptom."
      },
      "stage_3_select": {
        "disambiguation_logic": "Select finding concepts over disorder concepts when describing observations or symptoms. Choose the concept that best matches the clinical observation being documented.",
        "preferred_hierarchy": "finding",
        "reject_hierarchies": [
          "situation",
          "qualifier value"
        ]
      }
    },
    {
      "rule_id": "R3",
      "concept_type": "Neurological_Finding",
      "applies_to": {
        "ancestor_concept_ids": [
          102957003,
          298314008
        ],
        "sections": [
          "neurologic",
          "physical exam"
        ],
        "span_pattern": null
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "For neurological examination findings, search using the clinical term for the sign or symptom. For named neurological tests, search for the test name."
      },
      "stage_3_select": {
        "disambiguation_logic": "For neurological signs, prefer specific neurological finding concepts. For examination techniques or tests, select procedure concepts.",
        "preferred_hierarchy": "finding",
        "reject_hierarchies": [
          "body structure"
        ]
      }
    },
    {
      "rule_id": "R4",
      "concept_type": "Disease_Disorder",
      "applies_to": {
        "ancestor_concept_ids": [
          64572001
        ],
        "sections": null,
        "span_pattern": null
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "Search for the disease or disorder name. For abbreviated conditions, expand to the full clinical diagnosis name."
      },
      "stage_3_select": {
        "disambiguation_logic": "Select disorder concepts for diagnosed conditions. Prefer the most specific disorder concept that matches the clinical context.",
        "preferred_hierarchy": "disorder",
        "reject_hierarchies": [
          "finding",
          "morphologic abnormality"
        ]
      }
    },
    {
      "rule_id": "R5",
      "concept_type": "Procedure",
      "applies_to": {
        "ancestor_concept_ids": [
          128927009
        ],
        "sections": null,
        "span_pattern": null
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "Search for the procedure or intervention name. For diagnostic tests, include the type of test in the search."
      },
      "stage_3_select": {
        "disambiguation_logic": "Select procedure concepts for actions, interventions, or tests being performed. For test results or observations, select finding concepts instead.",
        "preferred_hierarchy": "procedure",
        "reject_hierarchies": [
          "finding",
          "observable entity"
        ]
      }
    },
    {
      "rule_id": "R6",
      "concept_type": "Laboratory_Test",
      "applies_to": {
        "ancestor_concept_ids": [
          386053000
        ],
        "sections": [
          "pertinent results"
        ],
        "span_pattern": null
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "For laboratory test names, search for the full test name including what is being measured. For test result interpretations, search for the finding."
      },
      "stage_3_select": {
        "disambiguation_logic": "For the test itself, select procedure concepts. For abnormal results or interpretations, select finding concepts.",
        "preferred_hierarchy": "procedure",
        "reject_hierarchies": [
          "substance",
          "organism"
        ]
      }
    },
    {
      "rule_id": "R7",
      "concept_type": "Morphologic_Abnormality",
      "applies_to": {
        "ancestor_concept_ids": [
          49755003
        ],
        "sections": null,
        "span_pattern": null
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "Search for the pathological or morphological abnormality described."
      },
      "stage_3_select": {
        "disambiguation_logic": "Select morphologic abnormality concepts for structural changes or pathological findings.",
        "preferred_hierarchy": "morphologic abnormality",
        "reject_hierarchies": [
          "finding",
          "disorder"
        ]
      }
    },
    {
      "rule_id": "R8",
      "concept_type": "Cranial_Nerve",
      "applies_to": {
        "ancestor_concept_ids": [
          25238003
        ],
        "sections": [
          "physical exam",
          "neurologic"
        ],
        "span_pattern": "single_letter"
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "For Roman numeral cranial nerve references, convert to the full cranial nerve name (e.g., 'III' to 'oculomotor nerve')."
      },
      "stage_3_select": {
        "disambiguation_logic": "Select the specific cranial nerve body structure concept.",
        "preferred_hierarchy": "body structure",
        "reject_hierarchies": [
          "finding",
          "procedure"
        ]
      }
    },
    {
      "rule_id": "R9",
      "concept_type": "Medication_Therapy",
      "applies_to": {
        "ancestor_concept_ids": [
          416608005
        ],
        "sections": null,
        "span_pattern": null
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "For medication names mentioned as treatments, search for the therapy or administration concept, not just the substance."
      },
      "stage_3_select": {
        "disambiguation_logic": "When medication is mentioned as a treatment, prefer therapy/administration procedure concepts over substance concepts.",
        "preferred_hierarchy": "procedure",
        "reject_hierarchies": [
          "substance",
          "product"
        ]
      }
    },
    {
      "rule_id": "R10",
      "concept_type": "Imaging_Finding",
      "applies_to": {
        "ancestor_concept_ids": [
          365853002
        ],
        "sections": [
          "pertinent results"
        ],
        "span_pattern": null
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "For imaging findings, search for the radiological finding or abnormality described."
      },
      "stage_3_select": {
        "disambiguation_logic": "Select imaging finding concepts when available, otherwise general finding concepts.",
        "preferred_hierarchy": "finding",
        "reject_hierarchies": [
          "procedure",
          "body structure"
        ]
      }
    },
    {
      "rule_id": "R11",
      "concept_type": "Vital_Sign",
      "applies_to": {
        "ancestor_concept_ids": [
          118227000
        ],
        "sections": [
          "physical exam"
        ],
        "span_pattern": "abbreviation"
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "For vital sign abbreviations, expand to the full vital sign name (e.g., 'P' to 'pulse rate', 'R' to 'respiratory rate')."
      },
      "stage_3_select": {
        "disambiguation_logic": "Select finding concepts for vital sign observations.",
        "preferred_hierarchy": "finding",
        "reject_hierarchies": [
          "procedure",
          "observable entity"
        ]
      }
    },
    {
      "rule_id": "R12",
      "concept_type": "Negated_Finding",
      "applies_to": {
        "ancestor_concept_ids": [
          404684003
        ],
        "sections": null,
        "span_pattern": null
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "For negated findings, search for the positive form of the finding or condition."
      },
      "stage_3_select": {
        "disambiguation_logic": "Select the standard concept for the finding, not 'absence of' variants, as negation is handled contextually.",
        "preferred_hierarchy": null,
        "reject_hierarchies": [
          "situation"
        ]
      }
    }
  ],
