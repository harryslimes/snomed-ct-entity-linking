        "intent_translation": "For medication names in therapeutic contexts, search for the drug therapy or administration procedure rather than just the substance name."
      },
      "stage_3_select": {
        "disambiguation_logic": "Prefer therapeutic procedure concepts that represent the administration or therapy with the medication over substance concepts.",
        "preferred_hierarchy": "procedure",
        "reject_hierarchies": [
          "substance",
          "product"
        ]
      }
    },
    {
