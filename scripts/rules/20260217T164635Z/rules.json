    "LDLcalc": "calculated LDL cholesterol",
    "IGG": "immunoglobulin G measurement"
  },
  "g_rules": [
    {
      "id": "G1",
      "rule": "For abbreviations and acronyms not in mappings, expand the abbreviation to its full medical meaning before searching SNOMED. Consider clinical context and section location when expanding ambiguous abbreviations.",
      "stages": [
        "stage_2_search"
      ]
    },
    {
      "id": "G2",
      "rule": "When multiple SNOMED concepts match a clinical term, prefer concepts from the most clinically specific hierarchy. For diagnostic contexts prefer 'disorder', for examination findings prefer 'finding', for interventions prefer 'procedure'.",
      "stages": [
        "stage_3_select"
      ]
    },
    {
      "id": "G3",
      "rule": "For negated clinical expressions (marked by 'no', 'without', 'denies', 'absent'), search for the positive form of the concept rather than 'absence of' or 'no evidence of' variants.",
      "stages": [
        "stage_2_search"
      ]
    },
    {
      "id": "G4",
      "rule": "When examining anatomical references, include relevant qualifiers from context such as laterality (right/left), size descriptors, or structural relationships.",
      "stages": [
        "stage_2_search",
        "stage_3_select"
      ]
    }
  ],
  "structured_rules": [
    {
      "rule_id": "R1",
      "concept_type": "Allergy_Finding",
      "applies_to": {
        "ancestor_concept_ids": [
          91936005
        ],
        "sections": [
          "allergies",
          "adverse drug"
        ],
        "span_pattern": null
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "For medication names in allergy sections, transform to 'allergy to [medication name]' format for SNOMED search to find allergy concepts rather than drug substance concepts."
      },
      "stage_3_select": {
        "disambiguation_logic": "Prefer concepts from the 'finding' hierarchy that explicitly represent allergic reactions or hypersensitivity rather than drug substance concepts.",
        "preferred_hierarchy": "finding",
        "reject_hierarchies": [
          "substance",
          "product"
        ]
      }
    },
    {
      "rule_id": "R2",
      "concept_type": "Anatomical_Structure",
      "applies_to": {
        "ancestor_concept_ids": [
          91723000
        ],
        "sections": null,
        "span_pattern": null
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "For anatomical terms, include laterality qualifiers (right/left) and structural context from surrounding text. Add 'structure' to anatomical terms if not already present."
      },
      "stage_3_select": {
        "disambiguation_logic": "Prefer specific anatomical structure concepts over general regions. Include laterality when specified in the clinical text.",
        "preferred_hierarchy": "body structure",
        "reject_hierarchies": [
          "finding",
          "procedure"
        ]
      }
    },
    {
      "rule_id": "R3",
      "concept_type": "Clinical_Procedure",
      "applies_to": {
        "ancestor_concept_ids": [
          71388002
        ],
        "sections": null,
        "span_pattern": null
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "For test names, examination methods, and therapeutic interventions, search using the full procedural description including method and target anatomy when specified."
      },
      "stage_3_select": {
        "disambiguation_logic": "Prefer specific procedural concepts over general categories. Choose concepts that include the method, target anatomy, and clinical purpose when available.",
        "preferred_hierarchy": "procedure",
        "reject_hierarchies": [
          "finding",
          "disorder"
        ]
      }
    },
    {
      "rule_id": "R4",
      "concept_type": "Neurological_Finding",
      "applies_to": {
        "ancestor_concept_ids": [
          102957003
        ],
        "sections": null,
        "span_pattern": null
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "For neurological symptoms and signs, include qualifiers about laterality, severity, and functional impact. Transform descriptive language to clinical terminology."
      },
      "stage_3_select": {
        "disambiguation_logic": "Prefer specific neurological findings over general symptoms. Include anatomical location and functional context when selecting among candidates.",
        "preferred_hierarchy": "finding",
        "reject_hierarchies": [
          "disorder",
          "procedure"
        ]
      }
    },
    {
      "rule_id": "R5",
      "concept_type": "Cardiovascular_Disorder",
      "applies_to": {
        "ancestor_concept_ids": [
          49601007
        ],
        "sections": null,
        "span_pattern": null
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "For cardiovascular conditions, include pathophysiological descriptors (ischemic, embolic, stenotic) and anatomical location (coronary, cerebral, peripheral)."
      },
      "stage_3_select": {
        "disambiguation_logic": "Prefer specific cardiovascular disorder concepts that include etiology and anatomical location over general cardiovascular findings.",
        "preferred_hierarchy": "disorder",
        "reject_hierarchies": [
          "finding",
          "procedure"
        ]
      }
    },
    {
      "rule_id": "R6",
