        "intent_translation": "For laboratory test names, search using the full test name including measured analyte and specimen type when relevant."
      },
      "stage_3_select": {
        "disambiguation_logic": "Prefer specific laboratory procedure concepts over general categories. Choose concepts that specify the analyte being measured.",
