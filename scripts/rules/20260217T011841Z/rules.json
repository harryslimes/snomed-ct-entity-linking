  "g_rules": [
    {
      "id": "G1",
      "rule": "When generating search terms, expand all medical abbreviations to their full clinical terms using standard medical nomenclature",
      "stages": [
        "stage_2_search"
      ]
    },
    {
      "id": "G2",
      "rule": "For anatomical structures, if the span includes laterality information (left/right), preserve it in the search to find lateralized SNOMED concepts",
      "stages": [
        "stage_2_search",
        "stage_3_select"
      ]
    },
    {
      "id": "G3",
      "rule": "When concepts involve negation or absence, search for the positive finding and look for negated forms in the candidate list",
      "stages": [
        "stage_2_search",
        "stage_3_select"
      ]
    },
    {
      "id": "G4",
      "rule": "For medication names appearing in allergy sections, search for allergy-specific concepts rather than just the medication",
      "stages": [
        "stage_2_search"
      ]
    },
    {
      "id": "G5",
      "rule": "When selecting among hierarchy types, prefer procedure hierarchies for actions/interventions, finding hierarchies for observations, and disorder hierarchies for diagnoses",
      "stages": [
        "stage_3_select"
      ]
    },
    {
      "id": "G6",
      "rule": "For vital signs and measurements, prefer finding hierarchies over observable entity hierarchies when both are available",
      "stages": [
        "stage_3_select"
      ]
    },
    {
      "id": "G7",
      "rule": "Consider the clinical section context to disambiguate terms that have multiple medical meanings",
      "stages": [
        "stage_2_search",
        "stage_3_select"
      ]
    },
    {
      "id": "G8",
      "rule": "For complex clinical phrases, search using both the exact phrase and clinically equivalent synonym terms",
      "stages": [
        "stage_2_search"
      ]
    },
    {
      "id": "G9",
      "rule": "When a span represents a differential diagnosis that was ruled out, still annotate it but prefer disorder hierarchy concepts",
      "stages": [
        "stage_3_select"
      ]
    },
    {
      "id": "G10",
      "rule": "For discharge instruction items, interpret action-oriented phrases as patient education or counseling procedures rather than just clinical findings",
      "stages": [
        "stage_2_search",
        "stage_3_select"
      ]
    },
    {
      "id": "G11",
      "rule": "For post-surgical status notations using 's/p', search for the procedure concept rather than a post-procedure state finding",
      "stages": [
        "stage_2_search"
      ]
    },
    {
      "id": "G12",
      "rule": "When encountering clinical status descriptions that describe a patient's overall presentation, search for comprehensive clinical assessment findings",
      "stages": [
        "stage_2_search"
      ]
    },
    {
      "id": "G13",
      "rule": "For imaging and diagnostic test names, search for the procedure concept rather than the finding or result concept",
      "stages": [
        "stage_2_search",
        "stage_3_select"
      ]
    },
    {
      "id": "G14",
      "rule": "When a span describes progression or change in clinical status, search for concepts that capture the temporal aspect of the condition",
      "stages": [
        "stage_2_search"
      ]
    },
    {
      "id": "G15",
      "rule": "For laboratory test names, prefer procedure concepts over observable entity concepts, and never select the substance being measured",
      "stages": [
        "stage_3_select"
      ]
    }
  ],
  "structured_rules": [
    {
      "rule_id": "R1",
      "concept_type": "Physical_Exam_Abbreviation",
      "stage_1_span": {
        "label": "Physical_Exam_Abbreviation",
        "description": "Single capital letters or abbreviations in Physical Exam sections representing examination systems or findings"
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "Expand single letters to their anatomical meaning based on standard neurological exam conventions and search for the corresponding anatomical structure"
      },
      "stage_3_select": {
        "disambiguation_logic": "Select body structure concepts for anatomical references, nerve structure concepts for cranial nerves",
        "preferred_hierarchy": "body structure",
        "reject_hierarchies": []
      }
    },
    {
      "rule_id": "R2",
      "concept_type": "Allergy_Medication",
      "stage_1_span": {
        "label": "Allergy_Medication",
        "description": "Medication names appearing in allergy or adverse drug reaction sections"
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "Search for allergy to the medication rather than the medication itself"
      },
      "stage_3_select": {
        "disambiguation_logic": "Select allergy or adverse reaction concepts specific to the mentioned drug",
        "preferred_hierarchy": "finding",
        "reject_hierarchies": [
          "substance",
          "product"
        ]
      }
    },
    {
      "rule_id": "R3",
      "concept_type": "Clinical_Procedure",
      "stage_1_span": {
        "label": "Clinical_Procedure",
        "description": "References to medical procedures, tests, or interventions"
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "Use the standard medical name for the procedure, expanding any abbreviations"
      },
      "stage_3_select": {
        "disambiguation_logic": "Prefer procedure concepts over finding concepts for active interventions",
        "preferred_hierarchy": "procedure",
        "reject_hierarchies": [
          "finding"
        ]
      }
    },
    {
      "rule_id": "R4",
      "concept_type": "Negated_Finding",
      "stage_1_span": {
        "label": "Negated_Finding",
        "description": "Clinical findings that are explicitly negated or noted as absent"
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "Search for the positive form of the finding, as SNOMED often has specific absent/negative concepts"
      },
      "stage_3_select": {
        "disambiguation_logic": "Select concepts that indicate absence or negation of the finding",
        "preferred_hierarchy": "finding",
        "reject_hierarchies": []
      }
    },
    {
      "rule_id": "R5",
      "concept_type": "Functional_Status",
      "stage_1_span": {
        "label": "Functional_Status",
        "description": "Descriptions of patient abilities, activities, or functional capabilities"
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "Search for functional assessment or ability-related concepts"
      },
      "stage_3_select": {
        "disambiguation_logic": "Prefer finding concepts that describe functional abilities or limitations",
        "preferred_hierarchy": "finding",
        "reject_hierarchies": [
          "procedure"
        ]
      }
    },
    {
      "rule_id": "R6",
      "concept_type": "Diagnostic_Finding",
      "stage_1_span": {
        "label": "Diagnostic_Finding",
        "description": "Diagnoses, conditions, or pathological findings"
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "Use standard medical terminology for the condition, including common clinical synonyms"
      },
      "stage_3_select": {
        "disambiguation_logic": "Prefer disorder concepts for diseases, morphologic abnormality for pathological changes",
        "preferred_hierarchy": "disorder",
        "reject_hierarchies": [
          "finding"
        ]
      }
    },
    {
      "rule_id": "R7",
      "concept_type": "Anatomical_Structure",
      "stage_1_span": {
        "label": "Anatomical_Structure",
        "description": "References to body parts, organs, or anatomical regions"
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "Include laterality and specificity modifiers in the search"
      },
      "stage_3_select": {
        "disambiguation_logic": "Select the most specific anatomical concept that matches the clinical context",
        "preferred_hierarchy": "body structure",
        "reject_hierarchies": [
          "finding",
          "disorder"
        ]
      }
    },
    {
      "rule_id": "R8",
      "concept_type": "Clinical_Observation",
      "stage_1_span": {
        "label": "Clinical_Observation",
        "description": "Observable clinical signs, symptoms, or examination findings"
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "Use clinical terminology that captures the observed phenomenon"
      },
      "stage_3_select": {
        "disambiguation_logic": "Prefer finding concepts that represent clinical observations",
        "preferred_hierarchy": "finding",
        "reject_hierarchies": [
          "disorder"
        ]
      }
    },
    {
      "rule_id": "R9",
      "concept_type": "Care_Context",
      "stage_1_span": {
        "label": "Care_Context",
        "description": "References to healthcare services, departments, or care settings"
      },
      "stage_2_search": {
        "filtering_logic": "Drop if the concept cannot be mapped to a standard SNOMED care setting",
        "intent_translation": "Search for healthcare service or environment concepts"
      },
      "stage_3_select": {
        "disambiguation_logic": "Select concepts representing healthcare services or settings when available",
        "preferred_hierarchy": "environment",
        "reject_hierarchies": []
      }
    },
    {
      "rule_id": "R10",
      "concept_type": "Implicit_Concept",
      "stage_1_span": {
        "label": "Implicit_Concept",
        "description": "Text that implies a clinical concept through context rather than explicit naming"
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "Transform the implicit reference into the explicit clinical concept it represents"
      },
      "stage_3_select": {
        "disambiguation_logic": "Select concepts that capture the implied clinical meaning rather than literal interpretation",
        "preferred_hierarchy": null,
        "reject_hierarchies": []
      }
    },
    {
      "rule_id": "R11",
      "concept_type": "Single_Letter_Abbreviation",
      "stage_1_span": {
        "label": "Single_Letter_Abbreviation",
        "description": "Single letters used as medical abbreviations in clinical contexts"
      },
      "stage_2_search": {
        "filtering_logic": null,
        "intent_translation": "Expand based on section context and standard medical abbreviation conventions"
      },
      "stage_3_select": {
        "disambiguation_logic": "Use section context to disambiguate when multiple expansions are possible",
        "preferred_hierarchy": null,
        "reject_hierarchies": []
      }
    },
    {
      "rule_id": "R12",
      "concept_type": "Patient_Education",
      "stage_1_span": {
