{
  "g_rules": [
    {
      "id": "G1",
      "rule": "For SNOMED search generation, use the exact annotated span text as the primary search term, but also generate variations including: (1) expanded forms of abbreviations, (2) removal of qualifiers like 'severe' or 'large', (3) medical synonyms, and (4) the formal medical term if the span uses colloquial language"
    },
    {
      "id": "G2",
      "rule": "Always consider the section context when interpreting spans - the same text may map to different SNOMED concepts depending on whether it appears in History, Physical Exam, Medications, or Instructions sections"
    },
    {
      "id": "G3",
      "rule": "For span boundary detection, include the complete medical concept but exclude: (1) articles (a, an, the), (2) possessive pronouns (his, her, your), (3) temporal qualifiers unless integral to the concept, and (4) anatomical laterality unless it changes the concept"
    },
    {
      "id": "G4",
      "rule": "When selecting from SNOMED candidates, prefer concepts matching the semantic type expected for the section (e.g., procedures in surgical sections, findings in exam sections, disorders in diagnosis sections)"
    }
  ],
  "numbered_rules": [
    {
      "id": "R1",
      "rule": "For medication allergies, annotate the drug class or specific medication name, mapping to 'Allergy to X (finding)' concepts",
      "examples": [
        "Penicillins \u2192 Allergy to penicillin (finding)"
      ]
    },
    {
      "id": "R2",
      "rule": "In Physical Exam sections, single capital letters or standard abbreviations should be expanded to their full examination terms before SNOMED search",
      "examples": [
        "VS \u2192 Vital signs finding",
        "CV \u2192 Cardiovascular physical examination",
        "ABD \u2192 Examination of abdomen"
      ]
    },
    {
      "id": "R3",
      "rule": "Common physical exam abbreviations in findings should map to their standard interpretations",
      "examples": [
        "NAD \u2192 No abnormality detected",
        "RRR \u2192 Normal heart rate",
        "CTAB \u2192 Normal breath sounds",
        "c/c/e \u2192 cyanosis/clubbing/edema"
      ]
    },
    {
      "id": "R4",
      "rule": "For negated findings (afebrile, without problem), map to the positive/normal state rather than absence of the negative",
      "examples": [
        "afebrile \u2192 Fever (finding)",
        "voided without problem \u2192 Normal micturition"
      ]
    },
    {
      "id": "R5",
      "rule": "Multi-word clinical conditions should be annotated as complete phrases when they represent a single unified diagnosis",
      "examples": [
        "biliary pancreatitis",
        "gallstone pancreatitis",
        "pancreatic necrosis",
        "hiatal hernia"
      ]
    },
    {
      "id": "R6",
      "rule": "In discharge instructions, educational or activity-related spans should map to education/training procedures",
      "examples": [
        "ambulate \u2192 Ambulation training",
        "drink adequate amounts of fluids \u2192 Fluid intake education",
        "avoid lifting weights \u2192 Functional activity education"
      ]
    },
    {
      "id": "R7",
      "rule": "Anatomical structures mentioned in clinical contexts should map to body structure concepts",
      "examples": [
        "GI tract \u2192 Gastrointestinal tract structure",
        "esophagus \u2192 Esophageal structure"
      ]
    },
    {
      "id": "R8",
      "rule": "Clinical actions and interventions map to procedure concepts",
      "examples": [
        "drained \u2192 Incision AND drainage",
        "discussion \u2192 Discussion (procedure)",
        "teaching \u2192 Patient education"
      ]
    },
    {
      "id": "R9",
      "rule": "Status descriptions and clinical states map to finding concepts",
      "examples": [
        "improved \u2192 Patient's condition improved",
        "alive \u2192 Alive (finding)",
        "hemodynamically stable \u2192 Hemodynamically stable (finding)"
      ]
    },
    {
      "id": "R10",
      "rule": "Abbreviations for clinical locations/units should expand to their care management concepts",
      "examples": [
        "PACU \u2192 Postanesthesia care",
        "clinic \u2192 Outpatient care management",
        "PCP \u2192 Primary care management"
      ]
    },
    {
      "id": "R11",
      "rule": "Pain-related phrases should map to pain control or pain finding concepts based on context",
      "examples": [
        "pain control \u2192 Pain control (procedure)",
        "increased pain \u2192 Increased pain (finding)",
        "pain was well controlled \u2192 Demonstrates adequate pain control"
      ]
    },
    {
      "id": "R12",
      "rule": "Post-operative references should include the 'post operative' span when it modifies the clinical meaning",
      "examples": [
        "post operative period \u2192 Postoperative state (finding)"
      ]
    },
    {
      "id": "R13",
      "rule": "Wound/incision descriptions should map to morphologic abnormality concepts",
      "examples": [
        "incisions \u2192 Surgical incision wound",
        "pseudocyst \u2192 Pseudocyst (morphologic abnormality)"
      ]
    },
    {
      "id": "R14",
      "rule": "Treatment modalities map to regime/therapy concepts",
      "examples": [
        "nasojejunal feedings \u2192 Nasojejunal feeding (regime/therapy)",
        "heparin \u2192 Heparin therapy"
      ]
    },
    {
      "id": "R15",
      "rule": "In family history, include the complete disease phrase for inherited conditions",
      "examples": [
        "metastatic lung cancer",
        "pancreatic malignancy"
      ]
    },
    {
      "id": "R16",
      "rule": "Common clinical abbreviations in narrative text should be annotated with their expanded meanings",
      "examples": [
        "CVA \u2192 Cerebrovascular accident",
        "RA \u2192 Breathing room air"
      ]
    },
    {
      "id": "R17",
      "rule": "Activity and functional status descriptions map to mobility/functional finding concepts",
      "examples": [
        "ambulating \u2192 Fully mobile",
        "Ambulatory - Independent \u2192 Independent walking"
      ]
    },
    {
      "id": "R18",
      "rule": "Diagnostic test interpretations and clinical assessments map to their respective procedure or finding concepts",
      "examples": [
        "Mental Status \u2192 Neurological mental status determination",
        "Alert \u2192 Mentally alert"
      ]
    },
    {
      "id": "R19",
      "rule": "Skin findings should include descriptive terms that are clinically relevant",
      "examples": [
        "Warm \u2192 Warm skin (finding)",
        "redness \u2192 Redness of skin over lesion"
      ]
    },
    {
      "id": "R20",
      "rule": "For ambiguous abbreviations like 'c' in 'c/c/e', use section context to determine meaning (cyanosis in extremity exam)",
      "examples": [
        "c \u2192 Cyanosis (finding)",
        "e \u2192 Edema of extremity"
      ]
    }
  ],
